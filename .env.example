# Test Environment Variables
# Copy this to .env.test and modify as needed

NODE_ENV=test
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sankuko_test

# Midtrans test credentials (use sandbox/test keys)
MIDTRANS_SERVER_KEY=Mid-server-test-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-test-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# JWT settings for testing
JWT_SECRET=test-secret-key-change-in-production
JWT_EXPIRES_IN=1h

# CORS origin for testing
CORS_ORIGIN=http://localhost:3000

# Other service configurations
CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_key
CLOUDINARY_API_SECRET=test_secret